-- Starting point for a fresh local database.
-- Table definitions mirror src/main/resources/schema.sql (loaded automatically at startup).

BEGIN;

DROP TABLE IF EXISTS instructor_history;
DROP TABLE IF EXISTS students;
DROP TABLE IF EXISTS instructor;
DROP TABLE IF EXISTS course;

CREATE TABLE students (
    id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    courseid INTEGER NOT NULL DEFAULT 0,
    instructorname VARCHAR(50),
    hoursdone INTEGER NOT NULL DEFAULT 0,
    first_payment BOOLEAN NOT NULL DEFAULT FALSE,
    second_payment BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE UNIQUE INDEX students_id_uidx ON students (id);

CREATE TABLE instructor (
    instructorname VARCHAR(50) PRIMARY KEY,
    description VARCHAR(150),
    carnr INTEGER
);

CREATE TABLE course (
    course_id INTEGER PRIMARY KEY,
    startdate VARCHAR(50),
    price INTEGER
);

CREATE TABLE instructor_history (
    history_id INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    student_id INTEGER NOT NULL REFERENCES students(id) ON DELETE CASCADE,
    instructorname VARCHAR(50),
    hours INTEGER NOT NULL DEFAULT 0
);

